# ==========================
# Core Django settings
# ==========================
SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================
# Database
# ==========================
# LOCAL DEV DEFAULT — SQLite, no setup needed. Leave as-is if you're not
# connecting to the shared Supabase database.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# SHARED SUPABASE (team development) — get these from:
# Supabase dashboard > Project Settings > Database > Connection string
# Fill in DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT above instead of
# leaving them on SQLite, OR use DATABASE_URL below (either works).
#
# Example (do not commit real values, this is illustrative only):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-password-here
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_PORT=5432

# PRODUCTION ONLY (Render) — set this on the Render dashboard's
# Environment Variables page, never in your local .env or on GitHub.
# Use Supabase's "Transaction pooler" connection string (port 6543),
# not the direct connection.
# DATABASE_URL=postgres://user:pass@host:6543/dbname

# ==========================
# Render-specific (production only, set on Render dashboard)
# ==========================
# RENDER_EXTERNAL_HOSTNAME is set automatically by Render — do not set manually.